# Copy this file to .env and fill in real values. Never commit .env.
#
# If you used Vercel's Supabase integration, most of these are already
# sitting in your Vercel project's Environment Variables — run
# `vercel env pull .env` to grab them automatically instead of copying
# by hand.

# Flask
FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=true

# Supabase Auth (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Newer Supabase projects may instead show this as:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# (config.py accepts either name)

# Postgres — direct connection (Project Settings -> Database, or
# auto-injected by Vercel's Supabase integration). POSTGRES_URL is the
# pooled/PgBouncer connection used at request time; POSTGRES_URL_NON_POOLING
# is a direct connection, better suited to one-off scripts/migrations.
POSTGRES_URL=postgres://postgres:PASSWORD@HOST:6543/postgres?pgbouncer=true
POSTGRES_URL_NON_POOLING=postgres://postgres:PASSWORD@HOST:5432/postgres
POSTGRES_HOST=db.YOUR-PROJECT-REF.supabase.co
POSTGRES_DATABASE=postgres
POSTGRES_PASSWORD=your-database-password

# Cloudinary (Dashboard -> Account Details)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
